# Copy to .env and fill in. Never commit .env.
# check:submit fails if code reads an env var missing here or in README.
#
# Meta Model API key; exactly one is required for live models.
# MODEL_API_KEY is preferred, META_API_KEY is the alias.
MODEL_API_KEY=
META_API_KEY=
# Optional API base override (default https://api.meta.ai/v1).
MODEL_API_BASE_URL=
# Set to "real" to select live adapters when a key exists; anything
# else (or unset) uses deterministic offline stubs.
SECOND_LOOK_MODELS=
# Hard cap on real model calls per eval run (default 300).
SECOND_LOOK_CALL_BUDGET=
# The rest are read from the shell environment. The Next.js app also
# picks them up from .env (Next loads it); eval CLIs do not.
# Form audit log directory (default .audit).
AUDIT_DIR=
# ffmpeg binary for the clip path (default /opt/homebrew/bin/ffmpeg).
FFMPEG_BIN=
# demo:lan / demo:preflight server port (default 3100).
PORT=
# Simulated pipeline delay for the /form demo, e.g. 2000 (unset: live).
VERDICT_DELAY_MS=
# Screenshot tooling only (apps/web/scripts/shots.mts), shell exports.
# Base URL the shots run against.
SHOTS_BASE=
# System Chrome binary for Playwright.
SHOTS_CHROME=
