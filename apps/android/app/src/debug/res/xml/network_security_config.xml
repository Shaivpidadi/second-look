<?xml version="1.0" encoding="utf-8"?>
<!-- Debug only: allow cleartext HTTP to the Mac Studio on the LAN. -->
<network-security-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
